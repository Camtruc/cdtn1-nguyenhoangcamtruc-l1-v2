        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam defaultFontSize 12\nskinparam packageStyle rectangle\n\npackage \&quot;TẦNG 1: NGUỒN DỮ LIỆU (INGESTION)\&quot; #LightCyan {\n  file \&quot;orders.csv\\n(Đơn hàng)\&quot; as F_ORDERS\n  file \&quot;customers.csv\\n(Khách hàng)\&quot; as F_CUST\n}\n\npackage \&quot;TẦNG 2: XỬ LÝ &amp; KIỂM ĐỊNH (PROCESSING)\&quot; #Ivory {\n  component \&quot;Module Extract\\n(reader.py)\&quot; as MOD_EXT\n  component \&quot;Module Transform\\n(cleaner.py)\&quot; as MOD_TRANS\n  component \&quot;Module Quality\\n(validator.py)\&quot; as MOD_QUAL\n  file \&quot;reject_records.csv\\n(Bản ghi lỗi)\&quot; as F_REJECT\n}\n\npackage \&quot;TẦNG 3: KHO DỮ LIỆU (SERVING DWH)\&quot; #HoneyDew {\n  database \&quot;fact_purchase\&quot; as DB_FACT\n  database \&quot;dim_customer\&quot; as DB_CUST\n  database \&quot;dim_date\&quot; as DB_DATE\n}\n\npackage \&quot;TẦNG 4: TRÌNH DIỄN (VISUALIZATION)\&quot; #LavenderBlush {\n  component \&quot;Dashboard M1\\n(Tổng quan phân khúc)\&quot; as DASH_M1\n  component \&quot;Dashboard M2\\n(Ma trận RFM)\&quot; as DASH_M2\n  component \&quot;Dashboard M3\\n(Tra cứu khách hàng)\&quot; as DASH_M3\n}\n\npackage \&quot;VÙNG NGOÀI PHẠM VI (OUT OF SCOPE)\&quot; #MistyRose {\n  component \&quot;Cổng thanh toán Online\\n(Payment Gateway)\&quot; as OUT_PAY\n  component \&quot;Dịch vụ gửi tin tự động\\n(SMS/Email Gateway)\&quot; as OUT_SMS\n  component \&quot;Mô hình Deep Learning\\n(Dự đoán tương lai)\&quot; as OUT_AI\n}\n\nF_ORDERS --&gt; MOD_EXT : Đọc file CSV\nF_CUST --&gt; MOD_EXT : Đọc file CSV\n\nMOD_EXT --&gt; MOD_TRANS : DataFrame thô\nMOD_TRANS --&gt; MOD_QUAL : Chuẩn hóa ngày, tiền\nMOD_QUAL --&gt; F_REJECT : Tách dòng sai format/null\n\nMOD_QUAL --&gt; DB_FACT : Nạp batch insert (SQLAlchemy)\nMOD_QUAL --&gt; DB_CUST : Ghi đè SCD Type 1\nMOD_QUAL --&gt; DB_DATE : Nạp chiều ngày\n\nDB_FACT --&gt; DASH_M1 : SQL Query (&lt; 1.5s)\nDB_FACT --&gt; DASH_M2 : SQL Query (&lt; 1.5s)\nDB_CUST --&gt; DASH_M3 : Tra cứu qua Index ghép\nDB_DATE --&gt; DASH_M1 : Lọc theo thời gian\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="J9J4h1FaPqC8HYPgpSBr-27">
